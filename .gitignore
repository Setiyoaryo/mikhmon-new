# Temporary & OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.env

# Go build artifacts
/mikhmon-api
/mockrouteros
*.test
*.out
*.log

# Docker
docker-compose.override.yml

# Per-installation data: NOCIFY licence (install id + key). Never commit this.
include/license.php
include/license.php.*.tmp
include/license-secret.php
*.tmp

# Data portal langganan: basis data SQLite, kunci sesi, dan gambar QRIS.
data/

# Kredensial instalasi dari portal + cache heartbeat. Jangan di-commit:
# berisi token rahasia instalasi ini. Contohnya ada di instance.example.php.
include/instance.php
include/heartbeat-cache.php
include/heartbeat-cache-*.php
include/heartbeat-cache*.php.*.tmp

# Portal (Svelte) - hasil build dan dependensi tidak ikut di-commit.
# Jalankan: cd portal && npm install && npm run build
portal/node_modules/
portal/dist/
*.jar

# Sesi router per pelanggan: satu berkas = kredensial satu router, jadi
# isinya jangan ikut di-commit. Direktorinya dibuat otomatis oleh aplikasi
# (dan oleh tools/mikhmon-migrate-sessions.php).
include/sessions/*.php
include/sessions/*.php.bak
include/config.php.bak

# Kunci enkripsi per sesi. Contoh bentuknya ada di include/tenantkey.example.php.
include/tenantkey.php
include/tenantkey.php.bak
