# Mikhmon environment reference. The production compose file keeps these
# values literal; copy this file to `.env` only if you wire it up yourself.

# URL the PHP frontend uses to reach the Go microservice (docker network).
MIKHMON_API_URL=http://mikhmon-api:8088

# Listen address of the Go service inside its container.
MIKHMON_API_ADDR=:8088

# Max simultaneous RouterOS API connections per router.
MIKHMON_API_MAX_CONN_PER_ROUTER=32

# Close idle RouterOS API connections after this Go duration. Keep this well
# above how long someone reads a page, otherwise the next click pays a fresh
# TCP handshake and login to the router.
MIKHMON_API_IDLE_TIMEOUT=600s

# Optional shared secret between php-fpm and mikhmon-api (empty = disabled).
MIKHMON_API_TOKEN=

# Worker connections used for bulk voucher create/delete. 16 measured fastest
# against a single core RouterOS CHR; raising it made large batches slower.
MIKHMON_API_CONCURRENCY=16

# Timeouts (seconds) for the calls the PHP side makes to the Go service.
MIKHMON_API_CONNECT_TIMEOUT=20
MIKHMON_API_EXEC_TIMEOUT=120
MIKHMON_API_BULK_TIMEOUT=600
